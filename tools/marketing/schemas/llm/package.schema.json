{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goraxyy/Kehai/tools/marketing/schemas/llm/package.schema.json",
  "title": "Posting text for one language (what Claude writes)",
  "description": "package.py asks for one of these per language (it builds the answer's schema from this one: {\"<lang>\": <this>}) and saves them as <edit folder>/package.json. Lengths are checked in code: YouTube title 100, X 280, Bluesky 300, Instagram 2,200, TikTok 2,200 characters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["youtube", "instagram", "tiktok", "x", "bluesky", "pinned_comment", "thumbnail_text"],
  "properties": {
    "youtube": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "tags"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "instagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "hashtags"],
      "properties": { "caption": { "type": "string" }, "hashtags": { "type": "array", "items": { "type": "string" } } }
    },
    "tiktok": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "hashtags"],
      "properties": { "caption": { "type": "string" }, "hashtags": { "type": "array", "items": { "type": "string" } } }
    },
    "x": { "type": "string", "description": "The post, hashtags included." },
    "bluesky": { "type": "string", "description": "The post, hashtags included." },
    "pinned_comment": { "type": "string", "description": "A first comment that starts a conversation (a question)." },
    "thumbnail_text": { "type": "string", "description": "Long videos: 2 to 5 words for the thumbnail; shorts: ''." }
  }
}
