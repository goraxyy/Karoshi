# Copy to .env (gitignored) and fill in what you have. Nothing here is ever committed or printed.
# Owner setup checklist: BUILD_PLAN.md.

# Claude (console.anthropic.com): a key from the workspace with the $15 monthly limit.
ANTHROPIC_API_KEY=
# The pipeline's own cap, checked before every call (the Console limit is the hard stop behind it).
KEHAI_LLM_MONTHLY_USD=15
# Set to off if the API ever rejects server-side refusal fallbacks.
KEHAI_LLM_FALLBACK=default

# Azure Speech, free tier F0 (portal.azure.com): the key and its region, e.g. eastus.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
KEHAI_AZURE_MONTHLY_CHARS=500000

# ElevenLabs (optional backend).
ELEVENLABS_API_KEY=
KEHAI_ELEVENLABS_MONTHLY_CHARS=10000

# Phase 7: Telegram approvals (make a bot with @BotFather; send it /start, then
# `uv run run_job.py telegram-setup` prints your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Buffer (publish.buffer.com/settings/api).
BUFFER_API_KEY=
# Where Buffer fetches videos from (it refuses Drive links; Q8): an rclone remote serving files at
# a stable public URL, e.g. a Cloudflare R2 bucket with public access.
KEHAI_PUBLIC_REMOTE=
KEHAI_PUBLIC_URL=
# The rclone remote for the Drive archive (Q7).
# KEHAI_RCLONE_REMOTE=gdrive

# Trial runs: speak with the macOS voices; answer the Claude steps from files.
# KEHAI_TTS_BACKEND=say
# KEHAI_LLM_REPLAY=

# Where things are (defaults shown).
# KEHAI_MARKETING=~/TokenLimit/marketing
# KEHAI_SHIFT_RECORDS=~/Library/Application Support/TokenLimit/Kehai/shift_records
# KEHAI_LOCK_WAIT=0
